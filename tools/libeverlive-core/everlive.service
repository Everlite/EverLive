#
# EverLive Universal Userspace Capture Service
#
# Powers up the capture hardware, holds the VFIO context open, enables monitor
# passthrough, and dispatches virtual cameras and PipeWire audio streams at login.
#
# Install with:
#   systemctl --user daemon-reload
#   systemctl --user enable --now everlive.service

[Unit]
Description=EverLive Universal Userspace Capture Service
After=pipewire.service wireplumber.service
Wants=pipewire.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/everlive-service
Restart=on-failure
RestartSec=2
# Safe user-unit hardening.  Keep NoNewPrivileges=, ProtectSystem=,
# ProtectHome= and PrivateTmp= off until the VFIO memlock path no longer
# depends on cap_ipc_lock=+ep on the installed engine: NoNewPrivileges blocks
# file capabilities and user namespaces drop host CAP_IPC_LOCK, while a
# per-user LimitMEMLOCK= cannot raise the user manager's hard limit.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
LockPersonality=yes
RestrictSUIDSGID=yes
# VFIO DMA pinning is provided by cap_ipc_lock=+ep on the installed engine.
# When setcap is unavailable the installer adds a bounded LimitMEMLOCK drop-in.

[Install]
WantedBy=default.target
