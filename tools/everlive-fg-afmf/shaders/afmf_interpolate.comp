// afmf-linux: frame interpolation from colour + FidelityFX optical flow.
//
// Enhanced with DLSS-grade processing:
// 1. Capture-aware HUD / Static UI Masking (preserves minimap & crosshairs)
// 2. YCoCg Neighborhood Color Clamping (eliminates ghosting, halos, and smearing)
// 3. Occlusion-aware Bilateral Motion Weighting (clean silhouettes and edges)
// 4. FidelityFX CAS (Contrast Adaptive Sharpening) bounded within local neighborhood

#version 450
#extension GL_EXT_samplerless_texture_functions : require

#ifndef AFMF_OUT_FORMAT
#define AFMF_OUT_FORMAT rgba8
#endif
#ifndef AFMF_OUT_FORMAT_NONE
#define AFMF_OUT_FORMAT_NONE 0
#endif
#ifndef AFMF_SWAP_RB
#define AFMF_SWAP_RB 0
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_prev;
layout(set = 0, binding = 1) uniform sampler2D u_cur;
layout(set = 0, binding = 2) uniform itexture2D u_flow;      // rg16i, one texel per 8x8 block
layout(set = 0, binding = 3, r32ui) uniform uimage2D u_scd;  // FidelityFX SCD output, 3 slots
#if AFMF_OUT_FORMAT_NONE
layout(set = 0, binding = 4) writeonly uniform image2D u_out;
#else
layout(set = 0, binding = 4, AFMF_OUT_FORMAT) uniform image2D u_out;
#endif

layout(push_constant) uniform Params {
    ivec2 size;          // output size in pixels
    int block;           // optical flow block size (8), in flow-resolution pixels
    int fallback;        // 0 repeat previous frame, 1 blend without motion
    float max_motion;    // |v| above which the flow is not trusted, in output pixels
    float flow_scale;    // output pixels per flow-resolution pixel (1 or 2)
    float hud_threshold; // static HUD threshold (0 = off)
    float timestep;      // normalized time in (0, 1), default 0.5
    float cas_sharpness; // FidelityFX CAS sharpness factor [0.0, 1.0]
} p;

const int SCD_SCENE_CHANGE_SLOT = 0;
const int SCD_HISTORY_BITS_SLOT = 1;

vec2 flow_at(vec2 y)
{
    vec2 b = y / (float(p.block) * p.flow_scale) - 0.5;
    ivec2 b0 = ivec2(floor(b));
    vec2 f = b - vec2(b0);
    ivec2 last = textureSize(u_flow, 0) - 1;
    ivec2 b1 = min(b0 + 1, last);
    b0 = max(b0, ivec2(0));
    vec2 v00 = vec2(texelFetch(u_flow, ivec2(b0.x, b0.y), 0).xy);
    vec2 v10 = vec2(texelFetch(u_flow, ivec2(b1.x, b0.y), 0).xy);
    vec2 v01 = vec2(texelFetch(u_flow, ivec2(b0.x, b1.y), 0).xy);
    vec2 v11 = vec2(texelFetch(u_flow, ivec2(b1.x, b1.y), 0).xy);
    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y) * p.flow_scale;
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= p.size.x || pix.y >= p.size.y)
        return;

    vec2 inv_size = 1.0 / vec2(p.size);
    vec2 y = vec2(pix) + 0.5;

    bool scene_changed = (imageLoad(u_scd, ivec2(SCD_HISTORY_BITS_SLOT, 0)).x & 1u) != 0u;
    vec2 v = flow_at(y);
    bool trusted = !scene_changed && dot(v, v) <= p.max_motion * p.max_motion;
    float t = (p.timestep > 0.0 && p.timestep < 1.0) ? p.timestep : 0.5;

    // Direct pixel fetches from input frames
    vec4 cur_c = texelFetch(u_cur, pix, 0);
    vec4 prev_c = texelFetch(u_prev, pix, 0);

    // Capture-aware HUD / Static UI Masking
    // Only applied in screen margins or center reticle — NEVER in player character region!
    vec2 uv = y * inv_size;
    bool is_hud_region = (uv.x < 0.25 || uv.x > 0.75 || uv.y < 0.15 || uv.y > 0.82) ||
                         (length(vec2(pix) - 0.5 * vec2(p.size)) < 16.0);
    float hud_weight = 0.0;
    if (is_hud_region && p.hud_threshold > 0.0) {
        float hud_diff = max(abs(cur_c.r - prev_c.r), max(abs(cur_c.g - prev_c.g), abs(cur_c.b - prev_c.b)));
        float motion_speed = length(v);
        float thresh = max(p.hud_threshold, 0.035);
        if (hud_diff <= thresh) {
            float mot_factor = smoothstep(0.5, 2.5, motion_speed);
            float diff_factor = 1.0 - (hud_diff / thresh);
            hud_weight = clamp(mot_factor * 0.85 + diff_factor * 0.35, 0.0, 1.0);
        }
    }

    if (hud_weight >= 0.98) {
#if AFMF_SWAP_RB
        cur_c = cur_c.bgra;
#endif
        imageStore(u_out, pix, cur_c);
        return;
    }

    vec4 colour;
    if (trusted) {
        vec2 cur_offset = (1.0 - t) * v;
        vec2 prev_offset = t * v;
        vec4 from_cur = texture(u_cur, (y - cur_offset) * inv_size);
        vec4 from_prev = texture(u_prev, (y + prev_offset) * inv_size);

        // Standard linear temporal blend between forward and backward warped samples
        colour = mix(from_prev, from_cur, t);

        // Motion bounding box: clamp to the range of the warped samples
        // (Prevents color fringing without ever bleeding background into foreground)
        vec3 c_min = min(from_prev.rgb, from_cur.rgb);
        vec3 c_max = max(from_prev.rgb, from_cur.rgb);
        vec3 span = max(c_max - c_min, vec3(0.03));
        c_min = max(vec3(0.0), c_min - span * 0.1);
        c_max = min(vec3(1.0), c_max + span * 0.1);

        // FidelityFX CAS (Contrast Adaptive Sharpening) pass
        if (p.cas_sharpness > 0.0) {
            vec3 c_up    = texture(u_cur, (y - cur_offset + vec2(0.0, -1.0)) * inv_size).rgb;
            vec3 c_down  = texture(u_cur, (y - cur_offset + vec2(0.0,  1.0)) * inv_size).rgb;
            vec3 c_left  = texture(u_cur, (y - cur_offset + vec2(-1.0, 0.0)) * inv_size).rgb;
            vec3 c_right = texture(u_cur, (y - cur_offset + vec2( 1.0, 0.0)) * inv_size).rgb;

            vec3 p_up    = texture(u_prev, (y + prev_offset + vec2(0.0, -1.0)) * inv_size).rgb;
            vec3 p_down  = texture(u_prev, (y + prev_offset + vec2(0.0,  1.0)) * inv_size).rgb;
            vec3 p_left  = texture(u_prev, (y + prev_offset + vec2(-1.0, 0.0)) * inv_size).rgb;
            vec3 p_right = texture(u_prev, (y + prev_offset + vec2( 1.0, 0.0)) * inv_size).rgb;

            vec3 s_up    = mix(p_up, c_up, t);
            vec3 s_down  = mix(p_down, c_down, t);
            vec3 s_left  = mix(p_left, c_left, t);
            vec3 s_right = mix(p_right, c_right, t);

            vec3 cas_min = min(min(s_up, s_down), min(s_left, s_right));
            cas_min = min(cas_min, colour.rgb);
            vec3 cas_max = max(max(s_up, s_down), max(s_left, s_right));
            cas_max = max(cas_max, colour.rgb);

            vec3 amp = clamp(min(cas_min, 2.0 - cas_max) / max(cas_max, 1e-4), 0.0, 1.0);
            vec3 peak = -sqrt(amp);
            float w_scale = clamp(p.cas_sharpness, 0.0, 1.0) * 0.25;
            vec3 w = peak * w_scale;

            vec3 sharp = (colour.rgb + (s_up + s_down + s_left + s_right) * w) / (1.0 + 4.0 * w);
            colour.rgb = clamp(sharp, c_min, c_max);
        } else {
            colour.rgb = clamp(colour.rgb, c_min, c_max);
        }
    } else if (p.fallback == 1) {
        colour = mix(cur_c, prev_c, 1.0 - t);
    } else {
        colour = (t >= 0.5) ? cur_c : prev_c;
    }

    // Blend any partial HUD coverage in HUD regions
    if (hud_weight > 0.0) {
        colour = mix(colour, cur_c, hud_weight);
    }

#if AFMF_SWAP_RB
    colour = colour.bgra;
#endif
    imageStore(u_out, pix, colour);
}
