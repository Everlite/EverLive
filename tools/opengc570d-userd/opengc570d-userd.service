#
# Per-user service for the GC570D userspace VFIO engine.
# Install with `make install`, then enable it for the desktop user that owns
# the video group membership and the PipeWire session:
#
#   systemctl --user daemon-reload
#   systemctl --user enable --now opengc570d-userd.service
#
# Adjust ExecStart if the nodes or input selection differ on this machine.

[Unit]
Description=EverLive GC570D (Live Gamer DUO) userspace capture engine
After=pipewire.service wireplumber.service
Wants=pipewire.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/opengc570d-userd --headless --loopback
Restart=on-failure
RestartSec=2
# Safe user-unit hardening.  Keep NoNewPrivileges=, ProtectSystem=,
# ProtectHome= and PrivateTmp= off until the VFIO memlock path no longer
# depends on cap_ipc_lock=+ep on the installed engine: NoNewPrivileges blocks
# file capabilities and user namespaces drop host CAP_IPC_LOCK, while a
# per-user LimitMEMLOCK= cannot raise the user manager's hard limit.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
LockPersonality=yes
RestrictSUIDSGID=yes
# VFIO DMA pinning is provided by cap_ipc_lock=+ep on the installed binary.
# When setcap is unavailable the installer adds a bounded LimitMEMLOCK drop-in.

[Install]
WantedBy=default.target
