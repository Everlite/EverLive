# SPDX-License-Identifier: GPL-2.0-only
# Bind only the AVerMedia Live Gamer DUO (GC570D, 1461:0054 subsystem 1461:5700)
# to vfio-pci.  The GC573 shares 1461:0054 but has subsystem 1461:5730, so the
# subsystem match keeps the two cards from claiming each other.
ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x1461", ATTR{device}=="0x0054", ATTR{subsystem_vendor}=="0x1461", ATTR{subsystem_device}=="0x5700", ATTR{driver_override}="vfio-pci", RUN+="/usr/local/libexec/gc570d-vfio-bind.sh --udev %k"
