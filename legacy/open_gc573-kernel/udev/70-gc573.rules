SUBSYSTEM=="video4linux", KERNEL=="video*", \
  ATTR{index}=="0", SUBSYSTEMS=="pci", ATTRS{vendor}=="0x1461", \
  ATTRS{device}=="0x0054", ATTRS{subsystem_vendor}=="0x1461", \
  ATTRS{subsystem_device}=="0x5730", ATTRS{serial_number}=="?*", \
  ENV{ID_BUS}="pci", \
  ENV{ID_SERIAL}="AVerMedia_Live_Gamer_4K_GC573_$attr{serial_number}", \
  SYMLINK+="v4l/by-id/$env{ID_BUS}-$env{ID_SERIAL}-video-index$attr{index}"

SUBSYSTEM=="video4linux", KERNEL=="video*", \
  ATTR{index}=="0", SUBSYSTEMS=="pci", ATTRS{vendor}=="0x1461", \
  ATTRS{device}=="0x0054", ATTRS{subsystem_vendor}=="0x5550", ATTRS{serial_number}=="?*", \
  ENV{ID_BUS}="pci", \
  ENV{ID_SERIAL}="AVerMedia_Live_Gamer_BOLT_GC555_$attr{serial_number}", \
  SYMLINK+="v4l/by-id/$env{ID_BUS}-$env{ID_SERIAL}-video-index$attr{index}"

# Allow regular desktop users to control RGB LED lighting and trigger HDMI HPD re-sync
SUBSYSTEM=="leds", KERNEL=="gc573:rgb:status", ACTION=="add", RUN+="/bin/chgrp video /sys/class/leds/%k/brightness /sys/class/leds/%k/multi_intensity", RUN+="/bin/chmod 0660 /sys/class/leds/%k/brightness /sys/class/leds/%k/multi_intensity"
SUBSYSTEM=="pci", ATTRS{vendor}=="0x1461", ATTRS{device}=="0x0054", TEST=="hpd_pulse", RUN+="/bin/chgrp video /sys%p/hpd_pulse", RUN+="/bin/chmod 0660 /sys%p/hpd_pulse"
