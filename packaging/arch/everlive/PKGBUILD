# Maintainer: Scyllinice

pkgname=everlive
pkgver=1.5.0
pkgrel=1
pkgdesc="Userspace VFIO capture and console gaming suite for AVerMedia Live Gamer 4K (GC573) and Live Gamer DUO (GC570D)"
arch=('x86_64')
url="https://github.com/Everlite/EverLive"
license=('GPL-2.0-only')
depends=('sdl2' 'ffmpeg' 'libpipewire' 'python' 'pyside6' 'xcb-util-cursor' 'libcap' 'sh')
makedepends=('pkgconf')
optdepends=('v4l2loopback-dkms: Virtual Camera (/dev/video10) for OBS'
            'v4l-utils: v4l2-ctl for the virtual camera'
            'lsfg-vk: 2x console frame generation'
            'polkit: bind the card to vfio-pci from the desktop without a terminal')
backup=('etc/security/limits.d/99-everlive-memlock.conf')
install=everlive.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "EverLive-$pkgver"
  make
}

check() {
  cd "EverLive-$pkgver"
  make check
}

package() {
  cd "EverLive-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm0644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
